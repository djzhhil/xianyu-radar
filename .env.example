# Copy to .env and fill in. Never commit real .env.
RADAR_AUTH_MODE=broker
RADAR_BROKER_URL=http://127.0.0.1:59188
RADAR_BROKER_TOKEN=
RADAR_ACCOUNT_ID=
RADAR_ENV=prod
# Optional: RADAR_MTOP_MIN_INTERVAL_SEC=1.0
# Optional pool round interval (seconds). Default 7200 ≈ 2h; jitter default 600.
# RADAR_SCAN_INTERVAL_SEC=7200
# RADAR_SCAN_JITTER_SEC=600
# Optional: RADAR_HTTP_PROXY=
